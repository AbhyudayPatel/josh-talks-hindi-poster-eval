 "examples": {
  "632098_unedited_long": [
   {
    "whisper_text": "नहीं, नहीं, वो जैसे बैकग्राउंड से रहते हैं, मतलब जैसे उसको मिलता है, जैसे कि आप लाओं से हैं, लेकिन आप सहर में रह रहे हैं।",
    "user_text": "नहीं, नहीं, वो जैसे बैकग्राउंड से रहते हैं, मतलब जैसे उसको मिलता है, जैसे कि आप लाओं से हैं, लेकिन आप सहर में रह रहे हैं।",
    "duration": 9.116809116809117
   },
   {
    "whisper_text": "जी जी जी लगता था जब सारे दोस्त साथ में होते थे अब तो पता नहीं कौन कहा कौन कहा ढंच से बात में नहीं हो पाता जी जी जी",
    "user_text": "जी जी जी लगता था जब सारे दोस्त साथ में होते थे अब तो पता नहीं कौन कहा कौन कहा ढंच से बात में नहीं हो पाता जी जी जी",
    "duration": 8.1888246628131
   },
